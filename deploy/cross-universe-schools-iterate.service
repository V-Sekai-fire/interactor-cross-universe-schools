[Unit]
Description=Cross Universe schools of play style: self-improving face-off rounds (oneshot, Turbo on the GPU, waits while VRChat runs)

[Service]
Type=oneshot
WorkingDirectory=/mnt/fire/3-interactor/interactor-cross-universe-schools
Environment=PATH=/home/fire/.pixi/bin:/usr/local/bin:/usr/bin:/bin
Environment=ELIXIR_ERL_OPTIONS=+fnu
Environment=CU_RESULTS=/mnt/fire/3-interactor/interactor-cross-universe-schools/results/iteration-4
Nice=19
CPUWeight=10
CPUQuota=100%
IOSchedulingClass=idle
MemoryHigh=3G
MemoryMax=4G
ExecCondition=/bin/sh -c 'test "$(cut -d. -f1 /proc/loadavg)" -lt 4'
ExecStart=/home/fire/.pixi/bin/elixir tools/schools.exs iterate
StandardOutput=append:/mnt/fire/3-interactor/interactor-cross-universe-schools/.work/iterate.log
StandardError=append:/mnt/fire/3-interactor/interactor-cross-universe-schools/.work/iterate.log
