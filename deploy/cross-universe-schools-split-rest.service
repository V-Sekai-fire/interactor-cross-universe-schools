[Unit]
Description=Cross Universe schools of play style: the last three split candidates of iteration 5 (oneshot, Turbo on the GPU)

[Service]
Type=oneshot
WorkingDirectory=/mnt/fire/3-interactor/interactor-cross-universe-schools
Environment=PATH=/home/fire/.pixi/bin:/usr/local/bin:/usr/bin:/bin
Environment=ELIXIR_ERL_OPTIONS=+fnu
Environment=CU_WORK=/mnt/fire/3-interactor/interactor-cross-universe-schools/.work/split-rest
Environment=CU_RESULTS=/mnt/fire/3-interactor/interactor-cross-universe-schools/results/iteration-5-rest
Nice=19
CPUWeight=10
CPUQuota=100%
IOSchedulingClass=idle
MemoryHigh=3G
MemoryMax=4G
ExecCondition=/bin/sh -c 'test "$(cut -d. -f1 /proc/loadavg)" -lt 4'
ExecStart=/home/fire/.pixi/bin/elixir tools/schools.exs split steady-if-first_turn-else-banker banker-if-first_turn-else-steady banker-no-bank-last
StandardOutput=append:/mnt/fire/3-interactor/interactor-cross-universe-schools/.work/split-rest.log
StandardError=append:/mnt/fire/3-interactor/interactor-cross-universe-schools/.work/split-rest.log
