[Unit]
Description=Cross Universe schools of play style, one frontier-learning run (oneshot, CPU only)

[Service]
Type=oneshot
WorkingDirectory=/mnt/fire/3-interactor/interactor-cross-universe-schools
Environment=PATH=/home/fire/.pixi/bin:/usr/local/bin:/usr/bin:/bin
Environment=ELIXIR_ERL_OPTIONS=+fnu
Nice=19
CPUWeight=10
CPUQuota=100%
IOSchedulingClass=idle
MemoryHigh=3G
MemoryMax=4G
ExecCondition=/bin/sh -c 'test "$(cut -d. -f1 /proc/loadavg)" -lt 4'
ExecStart=/home/fire/.pixi/bin/elixir tools/schools.exs run
StandardOutput=append:/mnt/fire/3-interactor/interactor-cross-universe-schools/.work/run.log
StandardError=append:/mnt/fire/3-interactor/interactor-cross-universe-schools/.work/run.log
